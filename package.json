{
  "name": "clipr-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "build:core": "pnpm --filter @clipr/core run build",
    "build:cli": "pnpm --filter clipr-cli run build",
    "build:web": "pnpm --filter @clipr/web run build",
    "build:worker": "pnpm --filter @clipr/worker run build",
    "dev:web": "pnpm --filter @clipr/web run dev",
    "dev:worker": "pnpm --filter @clipr/worker run dev",
    "test": "pnpm --filter './packages/*' run test",
    "test:coverage": "pnpm --filter './packages/*' run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "clean": "pnpm --filter './packages/*' run clean",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammadxcm/clipr.git"
  },
  "homepage": "https://github.com/hammadxcm/clipr#readme",
  "bugs": {
    "url": "https://github.com/hammadxcm/clipr/issues"
  },
  "author": "Hammad Khan",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "overrides": {
      "defu": ">=6.1.5",
      "vite": "^8.1.5",
      "esbuild": "^0.28.1",
      "@biomejs/biome": "2.5.15",
      "yaml": "^2.8.3",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "postcss": "^8.5.18",
      "sharp": "^0.35.4",
      "svgo": "^4.1.0",
      "undici": "^7.29.1",
      "ws": "^8.21.0",
      "fast-uri": "^3.1.7",
      "hono": "^4.13.5",
      "astro": "^7.2.8",
      "devalue": "^5.9.3",
      "smol-toml": "^1.7.1",
      "vitest": "^4.1.11",
      "@vitest/mocker": "^4.1.11",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2"
    }
  }
}
